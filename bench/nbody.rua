// N-body: floating point over arrays of bodies, the classic benchmarks-game shape.
let PI = 3.141592653589793
let SOLAR_MASS = 4.0 * PI * PI
let DAYS = 365.24

// each body is [x, y, z, vx, vy, vz, mass]
fn body(x, y, z, vx, vy, vz, m) { [x, y, z, vx * DAYS, vy * DAYS, vz * DAYS, m * SOLAR_MASS] }

fn advance(bodies, dt) {
    let n = bodies.len()
    for i in 0..n {
        let bi = bodies[i]
        for j in 0..n {
            if j > i {
                let bj = bodies[j]
                let dx = bi[0] - bj[0]
                let dy = bi[1] - bj[1]
                let dz = bi[2] - bj[2]
                let d2 = dx * dx + dy * dy + dz * dz
                let mag = dt / (d2 * math::sqrt(d2))
                let mi = bi[6] * mag
                let mj = bj[6] * mag
                bi[3] = bi[3] - dx * mj
                bi[4] = bi[4] - dy * mj
                bi[5] = bi[5] - dz * mj
                bj[3] = bj[3] + dx * mi
                bj[4] = bj[4] + dy * mi
                bj[5] = bj[5] + dz * mi
            }
        }
    }
    for i in 0..n {
        let b = bodies[i]
        b[0] = b[0] + dt * b[3]
        b[1] = b[1] + dt * b[4]
        b[2] = b[2] + dt * b[5]
    }
}

fn energy(bodies) {
    let n = bodies.len()
    let e = 0.0
    for i in 0..n {
        let bi = bodies[i]
        e += 0.5 * bi[6] * (bi[3] * bi[3] + bi[4] * bi[4] + bi[5] * bi[5])
        for j in 0..n {
            if j > i {
                let bj = bodies[j]
                let dx = bi[0] - bj[0]
                let dy = bi[1] - bj[1]
                let dz = bi[2] - bj[2]
                e -= bi[6] * bj[6] / math::sqrt(dx * dx + dy * dy + dz * dz)
            }
        }
    }
    e
}

let bodies = [
    body(0, 0, 0, 0, 0, 0, 1),
    body(4.84143144246472090, -1.16032004402742839, -0.103622044471123109,
         0.00166007664274403694, 0.00769901118419740425, -0.0000690460016972063023, 0.000954791938424326609),
    body(8.34336671824457987, 4.12479856412430479, -0.403523417114321381,
         -0.00276742510726862411, 0.00499852801234917238, 0.0000230417297573763929, 0.000285885980666130812),
    body(12.8943695621391310, -15.1111514016986312, -0.223307578892655734,
         0.00296460137564761618, 0.00237847173959480950, -0.0000296589568540237556, 0.0000436624404335156298),
    body(15.3796971148509165, -25.9193146099879641, 0.179258772950371181,
         0.00268067772490389322, 0.00162824170038242295, -0.0000951592254519715870, 0.0000515138902046611451),
]

// offset momentum
let px = 0.0
let py = 0.0
let pz = 0.0
for i in 0..bodies.len() {
    let b = bodies[i]
    px += b[3] * b[6]
    py += b[4] * b[6]
    pz += b[5] * b[6]
}
let sun = bodies[0]
sun[3] = -px / SOLAR_MASS
sun[4] = -py / SOLAR_MASS
sun[5] = -pz / SOLAR_MASS

let steps = if arg.len() > 0 { num(arg[0]) } else { 200000 }
let t = os::clock()
print("{energy(bodies):.9}")
for i in 0..steps { advance(bodies, 0.01) }
print("{energy(bodies):.9}")
print("# nbody {steps} steps in {os::clock() - t:.3}s")
