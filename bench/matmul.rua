// Matrix multiply: nested arrays, the classic cache-and-index test.
fn matrix(n, seed) {
    let m = []
    let s = seed
    for i in 0..n {
        let row = []
        for j in 0..n {
            s = (s * 16807) % 2147483647
            row.push(s % 100)
        }
        m.push(row)
    }
    m
}

fn multiply(a, b, n) {
    let out = []
    for i in 0..n {
        let row = []
        let ai = a[i]
        for j in 0..n {
            let sum = 0
            for k in 0..n { sum += ai[k] * b[k][j] }
            row.push(sum)
        }
        out.push(row)
    }
    out
}

let n = if arg.len() > 0 { num(arg[0]) } else { 200 }
let t = os::clock()
let a = matrix(n, 1)
let b = matrix(n, 7)
let c = multiply(a, b, n)
let trace = 0
for i in 0..n { trace += c[i][i] }
print("trace = {trace}")
print("# matmul n={n} in {os::clock() - t:.3}s")
