// Types in rua: optional, checked, and there at run time.
//
// Nothing here is required — a name with no type is `any`, and `any` fits
// everywhere. What is written is checked by `rua --check` and by the editor
// as you type, and the same declaration guards data coming in from outside.

type Point = #{ x: number, y: number }
type Ids = [number]

// A type may take parameters, and a function type may name its arguments —
// which is the point, since what an argument is *for* is what sends a reader
// to the source.
type Handler<T, U> = fn(route: string, data: T) -> U

fn dist2(p: Point, scale: number) -> number {
    (p.x * p.x + p.y * p.y) * scale
}

let origin: Point = #{ x: 3, y: 4 }
let ids: Ids = [1, 2, 3]
print("dist2 {dist2(origin, 2)}, {ids.len()} ids")

// A table with more fields than the shape asks for is still that shape.
let labelled = #{ x: 6, y: 8, name: "corner" }
print("labelled is {dist2(labelled, 1)} away")

// ---------------------------------------------------------------- guarding
// A type is also a value describing itself, so the declaration above is the
// only place the shape is written. `typeis` answers the way `try` does: the
// yes or no first, and why not after it.
type Item = #{ sku: string, qty: number }
type Order = #{ id: number, items: [Item] }

fn describe(order) {
    let (ok, why) = typeis(order, Order)
    if !ok { return "rejected — {why}" }
    "accepted, {order.items.len()} item(s)"
}

print(describe(#{ id: 1, items: [#{ sku: "a", qty: 2 }] }))
print(describe(#{ id: 1, items: [#{ sku: "a", qty: "two" }] }))
print(describe(#{ id: 1 }))

// ------------------------------------------------------------------ methods
// `impl` gives a shape methods without giving every value of it a copy of
// them. `v.len()` becomes `Vec2::len(v)` where the shape is known — one table
// of methods for the type, nothing carried on the instance.
type Vec2 = #{ x: number, y: number }

impl Vec2 {
    fn len(self) -> number { math::sqrt(self.x * self.x + self.y * self.y) }
    fn scaled(self, k: number) -> Vec2 { #{ x: self.x * k, y: self.y * k } }
}

fn vec(x: number, y: number) -> Vec2 { #{ x: x, y: y } }

let a: Vec2 = #{ x: 3, y: 4 }
let b = vec(6, 8)                      // the shape comes from what `vec` returns
print("len {a.len()}, {b.len()}, scaled {a.scaled(2).len()}")
print("the long way round: {Vec2::len(a)}")

// The shapes are ordinary tables, so a type can be passed like any value.
fn guard(shape) { |v| { typeis(v, shape) } }
let is_point = guard(Point)
print("is_point: {is_point(origin)} {is_point(42)}")
